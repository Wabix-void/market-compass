# 商情罗盘 MarketCompass — 官方开放平台凭据模板
#
# 不要直接改这个文件！运行配置向导，它会按提示把你粘贴的值写进 openapi.env：
#     python scripts/setup_openapi.py
#
# 配置好之后自检：
#     python scripts/check_openapi.py
#     python scripts/check_openapi.py --live
#
# 申请入口：
#   taobao  淘宝开放平台      https://open.taobao.com/
#   jd      京东宙斯开放平台   https://jos.jd.com/
#   pdd     拼多多开放平台     https://open.pinduoduo.com/

PROVIDER=taobao
APP_KEY=
APP_SECRET=
# 需要用户授权类接口时才填（京东叫 access_token，同样填在这里）
SESSION_KEY=
